rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', 'active') in ['active', 'warned'];
    }

    function isAdmin() {
      return isSignedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Requires the Storage service agent's Firestore rules lookup permission.
    function canUploadBook(sellerId, bookId) {
      let book = firestore.get(/databases/(default)/documents/books/$(bookId)).data;
      return isOwner(sellerId) && book.sellerId == sellerId && book.status == 'draft';
    }

    // Book covers — sellerId in path so ownership can be enforced
    match /covers/{sellerId}/{bookId}/{filename} {
      allow read: if true;
      allow create, update: if canUploadBook(sellerId, bookId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        isImage();
      allow delete: if isOwner(sellerId) || isAdmin();
    }

    // Raw manuscript files — stored alongside parsed Firestore chapters for copyright records
    match /manuscripts/{sellerId}/{bookId}/{filename} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create, update: if canUploadBook(sellerId, bookId) &&
        request.resource.size < 50 * 1024 * 1024 &&
        (request.resource.contentType == 'text/plain' ||
         request.resource.contentType == 'text/markdown' ||
         request.resource.contentType.matches('text/.*'));
      allow delete: if isOwner(sellerId) || isAdmin();
    }

    // Immutable paid magazine files. Only the authenticated server can read
    // them after checking library access; cleanup is also server-owned.
    match /magazines/{sellerId}/{bookId}/{filename} {
      allow read, update, delete: if false;
      allow create: if resource == null && canUploadBook(sellerId, bookId) &&
        firestore.get(/databases/(default)/documents/books/$(bookId)).data.publicationType == 'magazine' &&
        request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }

    // User avatars — public read, owner write/delete
    match /avatars/{userId}/{filename} {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource.size < 2 * 1024 * 1024 &&
        isImage();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ID verification documents — owner uploads (image or PDF), only admin reads
    match /verification/{userId}/{filename} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        isImageOrPdf();
      allow delete: if isAdmin();
    }

    // Tax forms — owner uploads (image or PDF), only admin reads
    match /tax/{userId}/{filename} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        isImageOrPdf();
      allow delete: if isAdmin();
    }

    // Immutable audio originals: server-authorized, bounded uploads only.
    match /audio/{creatorId}/{titleId}/{filename} {
      function validAudioUpload() {
        let title = firestore.get(/databases/(default)/documents/audioTitles/$(titleId)).data;
        return title.creatorId == creatorId && title.status == 'draft' &&
          ((filename == 'source.mp3' && title.ready == false && request.resource.size <= 250 * 1024 * 1024) ||
           (filename in title.get('partUploads', {}) && request.resource.size <= title.partUploads[filename] && request.resource.size <= 250 * 1024 * 1024));
      }
      allow read, update, delete: if false;
      allow create: if resource == null && isOwner(creatorId) && request.resource.size >= 128 &&
        request.resource.contentType == 'audio/mpeg' && validAudioUpload();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
