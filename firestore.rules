rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isSeller() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'seller' ||
        request.auth.token.get('role', '') == 'both' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'both'
      );
    }

    function hasBookAccess(bookId) {
      let book = get(/databases/$(database)/documents/books/$(bookId)).data;
      return isSignedIn() && !book.get('deletionPending', false) && (
        isAdmin() ||
        book.sellerId == request.auth.uid ||
        ((!book.get('isPreorder', false) || (book.get('releaseDate', null) != null && book.releaseDate <= request.time)) && (
        exists(/databases/$(database)/documents/library/$(request.auth.uid + '_' + bookId)) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active' &&
          book.inSubscription == true &&
          (book.get('subscriptionTiers', []).size() == 0 || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionPlan in book.subscriptionTiers) &&
          (book.get('subscriptionEligibleFrom', null) == null || book.subscriptionEligibleFrom <= request.time)
        )
        ))
      );
    }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid &&
        !request.resource.data.keys().hasAny(['legalAgreement']) &&
        request.resource.data.role in ['buyer', 'seller'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.subscriptionStatus == 'none' &&
        request.resource.data.subscriptionPlan == 'none' &&
        request.resource.data.subscriptionId == null &&
        request.resource.data.stripeCustomerId == null &&
        request.resource.data.referralCredits == 0;
      allow update: if isAdmin() || (isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'username', 'avatarUrl', 'bio', 'phone',
          'country', 'dateOfBirth', 'activeRole', 'notificationPreferences',
          'readerPreferences', 'favoriteGenre', 'language', 'currency', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    // Acceptance receipts are recorded only by the authenticated server route.
    match /legalAgreements/{uid}/versions/{version} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Books
    match /books/{bookId} {
      allow read: if resource.data.status == 'live' || isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid &&
        !exists(/databases/$(database)/documents/bookDeletions/$(bookId)) &&
        request.resource.data.status == 'draft' &&
        request.resource.data.copyrightReviewStatus == 'not_needed' &&
        request.resource.data.publishedAt == null &&
        !request.resource.data.keys().hasAny(['manuscriptUrl', 'coAuthors']) &&
        request.resource.data.totalSales == 0 && request.resource.data.totalBorrows == 0 &&
        request.resource.data.reviewCount == 0 && request.resource.data.averageRating == 0 &&
        request.resource.data.isFeatured == false;
      allow update: if !exists(/databases/$(database)/documents/bookDeletions/$(bookId)) && (isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid && resource.data.status == 'draft' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'sellerId', 'totalSales', 'totalBorrows', 'averageRating', 'reviewCount',
           'status', 'copyrightReviewStatus', 'publishedAt', 'isFeatured', 'manuscriptUrl', 'coAuthors'
         ])));
      // Permanent deletion uses the server cleanup workflow.
      allow delete: if false;

      // Chapters
      match /chapters/{chapterId} {
        allow read: if (resource.data.isPreview == true &&
          get(/databases/$(database)/documents/books/$(bookId)).data.status == 'live') || hasBookAccess(bookId);
        allow write: if !exists(/databases/$(database)/documents/bookDeletions/$(bookId)) && (isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/books/$(bookId)).data.sellerId == request.auth.uid &&
           get(/databases/$(database)/documents/books/$(bookId)).data.status == 'draft'));
      }
    }

    // Manuscript archives are never part of a public catalog record.
    match /privateBooks/{bookId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.sellerId == request.auth.uid &&
        !exists(/databases/$(database)/documents/bookDeletions/$(bookId)) &&
        get(/databases/$(database)/documents/books/$(bookId)).data.sellerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['sellerId', 'manuscriptPath']);
      allow delete: if isAdmin();
    }

    // Server-owned deletion receipts block reuse of deleted identifiers.
    match /bookDeletions/{bookId} {
      allow read, write: if false;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());
      // Fulfillment and financial records are written only by the Admin SDK.
      allow write: if false;
    }

    // Library
    match /library/{itemId} {
      allow get: if isSignedIn() && resource == null;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Wishlist
    match /wishlist/{itemId} {
      allow get: if isSignedIn() && resource == null;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.status == 'live';
    }

    // Reading progress
    match /readingProgress/{progressId} {
      allow get: if isSignedIn() && resource == null;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.status == 'live' &&
        progressId == request.auth.uid + '_' + request.resource.data.bookId;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if isAdmin() || (isSignedIn() &&
        get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.sellerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerReply', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Claim tokens, recipient emails and personal messages are API-only.
    match /bookGifts/{document=**} {
      allow read, write: if false;
    }

    // Reminder history and email payloads are server-only, including for authors.
    match /authorPayoutReminders/{document=**} {
      allow read, write: if false;
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid && (
        (request.resource.data.targetType == 'book' && get(/databases/$(database)/documents/books/$(request.resource.data.targetId)).data.status == 'live') ||
        (request.resource.data.targetType == 'review' && get(/databases/$(database)/documents/books/$(get(/databases/$(database)/documents/reviews/$(request.resource.data.targetId)).data.bookId)).data.status == 'live') ||
        (request.resource.data.targetType == 'user' && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)))
      );
      allow update: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isActive == true);
      allow write: if isAdmin();
    }

    // Promotion payments, review and counts are server-managed.
    match /bookPromotions/{campaignId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }
    match /promotionSettings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /promotionAudit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Promo codes
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Platform settings
    match /platformSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Borrow records
    match /borrowRecords/{recordId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ID Verification requests
    match /verificationRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.reviewedAt == null;
      allow update: if isAdmin();
    }

    // Public author fields are exposed by /api/authors; financial data is private.
    match /payoutReviews/{sellerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sellers/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create: if false;
      allow update: if isAdmin() || (isOwner(sellerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taxFormType', 'taxFormStatus']) &&
        request.resource.data.taxFormStatus in ['not_submitted', 'submitted'] &&
        request.resource.data.taxFormType in [null, 'W-9', 'W-8BEN']);
      allow delete: if isAdmin();
    }

    match /follows/{followId} {
      allow get: if isSignedIn() && resource == null;
      allow read: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow write: if false;
    }
  }
}
