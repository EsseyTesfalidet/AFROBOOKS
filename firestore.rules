rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isSeller() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'seller' ||
        request.auth.token.get('role', '') == 'both' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'both'
      );
    }

    function hasBookAccess(bookId) {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/books/$(bookId)).data.sellerId == request.auth.uid ||
        exists(/databases/$(database)/documents/library/$(request.auth.uid + '_' + bookId)) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active' &&
          get(/databases/$(database)/documents/books/$(bookId)).data.inSubscription == true
        )
      );
    }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid &&
        request.resource.data.role in ['buyer', 'seller'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.subscriptionStatus == 'none' &&
        request.resource.data.subscriptionPlan == 'none' &&
        request.resource.data.subscriptionId == null &&
        request.resource.data.stripeCustomerId == null &&
        request.resource.data.referralCredits == 0;
      allow update: if isAdmin() || (isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'username', 'avatarUrl', 'bio', 'phone',
          'country', 'dateOfBirth', 'activeRole', 'notificationPreferences',
          'readerPreferences', 'favoriteGenre', 'language', 'currency', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    // Books
    match /books/{bookId} {
      allow read: if resource.data.status == 'live' || isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.totalSales == 0 && request.resource.data.totalBorrows == 0 &&
        request.resource.data.reviewCount == 0 && request.resource.data.averageRating == 0 &&
        request.resource.data.isFeatured == false;
      allow update: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'sellerId', 'totalSales', 'totalBorrows', 'averageRating', 'reviewCount'
         ]));
      allow delete: if isAdmin();

      // Chapters
      match /chapters/{chapterId} {
        allow read: if (resource.data.isPreview == true &&
          get(/databases/$(database)/documents/books/$(bookId)).data.status == 'live') || hasBookAccess(bookId);
        allow write: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/books/$(bookId)).data.sellerId == request.auth.uid);
      }
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());
      // Fulfillment and financial records are written only by the Admin SDK.
      allow write: if false;
    }

    // Library
    match /library/{itemId} {
      allow get: if isSignedIn() && resource == null;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Wishlist
    match /wishlist/{itemId} {
      allow get: if isSignedIn() && resource == null;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Reading progress
    match /readingProgress/{progressId} {
      allow get: if isSignedIn() && resource == null;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        progressId == request.auth.uid + '_' + request.resource.data.bookId;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if isAdmin() || (isSignedIn() &&
        get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.sellerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerReply', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isActive == true);
      allow write: if isAdmin();
    }

    // Promo codes
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // Platform settings
    match /platformSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Borrow records
    match /borrowRecords/{recordId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ID Verification requests
    match /verificationRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Public author fields are exposed by /api/authors; financial data is private.
    match /sellers/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create: if false;
      allow update: if isAdmin() || (isOwner(sellerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taxFormType', 'taxFormStatus']) &&
        request.resource.data.taxFormStatus in ['not_submitted', 'submitted'] &&
        request.resource.data.taxFormType in [null, 'W-9', 'W-8BEN']);
      allow delete: if isAdmin();
    }

    match /follows/{followId} {
      allow get: if isSignedIn() && resource == null;
      allow read: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow write: if false;
    }
  }
}
